{
  "name": "ROS2 Humble Coursework",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "george"
    }
  },
  "remoteUser": "george",
  "workspaceFolder": "/home/ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-python.python"
      ]
    }
  },
  "runArgs": [
    "--net=host",
    "--pid=host",
    "--ipc=host",
    "-e",
    "DISPLAY=${env:DISPLAY}"
  ],
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ]
}